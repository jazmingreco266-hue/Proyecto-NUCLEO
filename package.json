{
  "name": "nucleo-panel",
  "version": "0.2.0",
  "description": "Panel operativo de Núcleo",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "user:create": "node --env-file-if-exists=.env --import tsx scripts/create-user.ts",
    "seed:ejemplo": "node --env-file-if-exists=.env --import tsx scripts/seed-ejemplo.ts",
    "vercel-build": "node --import tsx scripts/migrate.ts && next build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jazmingreco266-hue/proyecto-nucleo.git"
  },
  "bugs": {
    "url": "https://github.com/jazmingreco266-hue/proyecto-nucleo/issues"
  },
  "homepage": "https://github.com/jazmingreco266-hue/proyecto-nucleo#readme",
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  }
}
