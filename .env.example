# Copiá este archivo como .env y completá los valores. El .env nunca se sube al repositorio.

# Conexión a PostgreSQL 16+
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/nucleo

# Base separada para los tests (se borra y recrea en cada corrida)
TEST_DATABASE_URL=postgres://usuario:contraseña@localhost:5432/nucleo_test

# Clave estable para cifrar Server Actions si hay más de una instancia (32 bytes en base64).
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Código para crear la cuenta de propietario desde /configuracion-inicial (mínimo 16 caracteres).
# Después de crear tu cuenta, podés borrarlo: la página deja de existir cuando hay un usuario.
SETUP_TOKEN=

# Secreto para /api/cron/agentes (mínimo 16 caracteres). Vercel Cron lo envía como
# "Authorization: Bearer <CRON_SECRET>". Sin esta variable, el endpoint responde 401.
CRON_SECRET=

# Opcional: página o email de contacto que el lector de sitios incluye en su user-agent,
# para que los dueños de los sitios sepan quién los visita.
BOT_CONTACT_URL=

# Clave de la API de Anthropic para la investigación con IA (https://platform.claude.com).
# Sin ella, la IA queda apagada y el resto del panel funciona igual.
# Además hay que definir un presupuesto mensual mayor a 0 en Configuración.
ANTHROPIC_API_KEY=
