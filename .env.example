# Copiá este archivo a .env.local y completá con tu Client ID real de Google
# (ver README, sección "Activar Sign in with Google") para habilitar el botón
# "Continuar con Google". Sin esta variable, la app funciona igual con
# email + contraseña.
VITE_GOOGLE_CLIENT_ID=

# Copiá estas tres claves desde tu cuenta de EmailJS (ver README, sección
# "Activar el mail de confirmación") para que al crear una cuenta se mande
# un mail de bienvenida real. Sin estas variables, la app funciona igual,
# solo que no se envía el mail.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
